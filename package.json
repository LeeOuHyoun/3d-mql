{
  "name": "3d-mql",
  "displayName": "3D MQL Graph",
  "description": "ENOVIA MQL로 객체와 관계를 그래프로 탐색합니다.",
  "version": "0.0.25",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "3d-mql.openGraph",
        "title": "3D MQL: 새 관계 그래프 열기"
      },
      {
        "command": "3d-mql.graph.clear",
        "title": "3D MQL: 그래프 지우기"
      },
      {
        "command": "3d-mql.graph.fit",
        "title": "3D MQL: 화면 맞춤"
      },
      {
        "command": "3d-mql.graph.relationPanel",
        "title": "3D MQL: 관계 필터 · 범례 패널 열기/닫기"
      },
      {
        "command": "3d-mql.graph.detailPanel",
        "title": "3D MQL: 상세 패널 열기/닫기"
      },
      {
        "command": "3d-mql.graph.minimap",
        "title": "3D MQL: 미니맵 열기/닫기"
      },
      {
        "command": "3d-mql.graph.console",
        "title": "3D MQL: MQL 콘솔 열기/닫기"
      },
      {
        "command": "3d-mql.graph.back",
        "title": "3D MQL: 이전 기준 객체"
      },
      {
        "command": "3d-mql.graph.forward",
        "title": "3D MQL: 다음 기준 객체"
      },
      {
        "command": "3d-mql.graph.graphFullscreen",
        "title": "3D MQL: 그래프 전체 화면 전환"
      },
      {
        "command": "3d-mql.graph.consoleFullscreen",
        "title": "3D MQL: MQL 콘솔 전체 화면 전환"
      },
      {
        "command": "3d-mql.graph.shortcuts",
        "title": "3D MQL: 단축키 안내"
      },
      {
        "command": "3d-mql.graph.suggest",
        "title": "3D MQL: MQL 콘솔 명령 제안"
      },
      {
        "command": "3d-mql.graph.format",
        "title": "3D MQL: MQL 콘솔 입력 포매팅"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "3d-mql.graph.clear",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.fit",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.relationPanel",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.detailPanel",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.minimap",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.console",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.back",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.forward",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.graphFullscreen",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.consoleFullscreen",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.shortcuts",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.suggest",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        },
        {
          "command": "3d-mql.graph.format",
          "when": "activeWebviewPanelId == '3d-mql.graph'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "3d-mql.graph.clear",
        "key": "ctrl+l",
        "when": "activeWebviewPanelId == '3d-mql.graph'"
      },
      {
        "command": "3d-mql.graph.minimap",
        "key": "alt+m",
        "when": "activeWebviewPanelId == '3d-mql.graph'"
      },
      {
        "command": "3d-mql.graph.fit",
        "key": "ctrl+alt+f",
        "when": "activeWebviewPanelId == '3d-mql.graph'"
      },
      {
        "command": "3d-mql.graph.relationPanel",
        "key": "alt+l",
        "when": "activeWebviewPanelId == '3d-mql.graph'"
      },
      {
        "command": "3d-mql.graph.detailPanel",
        "key": "alt+d",
        "when": "activeWebviewPanelId == '3d-mql.graph'"
      },
      {
        "command": "3d-mql.graph.back",
        "key": "alt+[",
        "when": "activeWebviewPanelId == '3d-mql.graph'"
      },
      {
        "command": "3d-mql.graph.forward",
        "key": "alt+]",
        "when": "activeWebviewPanelId == '3d-mql.graph'"
      },
      {
        "command": "3d-mql.graph.console",
        "key": "alt+b",
        "when": "activeWebviewPanelId == '3d-mql.graph'"
      },
      {
        "command": "3d-mql.graph.graphFullscreen",
        "key": "ctrl+alt+g",
        "when": "activeWebviewPanelId == '3d-mql.graph'"
      },
      {
        "command": "3d-mql.graph.consoleFullscreen",
        "key": "ctrl+alt+c",
        "when": "activeWebviewPanelId == '3d-mql.graph'"
      },
      {
        "command": "3d-mql.graph.shortcuts",
        "key": "ctrl+shift+l",
        "when": "activeWebviewPanelId == '3d-mql.graph'"
      },
      {
        "command": "3d-mql.graph.suggest",
        "key": "ctrl+space",
        "when": "activeWebviewPanelId == '3d-mql.graph' && 3d-mql.consoleFocus"
      },
      {
        "command": "3d-mql.graph.format",
        "key": "ctrl+shift+f",
        "when": "activeWebviewPanelId == '3d-mql.graph' && 3d-mql.consoleFocus"
      }
    ],
    "configuration": {
      "title": "3D MQL Graph",
      "properties": {
        "3d-mql.contextCommand": {
          "type": "string",
          "default": "set context user creator;",
          "description": "MQL 세션 시작 직후 실행할 접속 명령입니다."
        },
        "3d-mql.searchLimit": {
          "type": "number",
          "default": 200,
          "description": "객체 검색 결과 최대 건수입니다."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:extension": "node esbuild.js",
    "build:webview": "vite build --config webview/vite.config.js",
    "watch:webview": "vite build --watch --config webview/vite.config.js",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@lucide/vue": "^1.69.0",
    "cytoscape": "^3.34.4",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-fcose": "^2.2.0",
    "lodash-es": "^4.18.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.101.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vscode/vsce": "^4.1.0",
    "@vueuse/core": "^15.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.2",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.3.6"
  }
}
