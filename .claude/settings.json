{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npx tsc --noEmit -p .)",
      "Bash(npm run build)",
      "Bash(npm run build:extension)",
      "Bash(npm run build:webview)",
      "Bash(npm run package)",
      "PowerShell(npm.cmd run build)",
      "PowerShell(npm.cmd run build:extension)",
      "PowerShell(npm.cmd run build:webview)",
      "PowerShell(npm.cmd run package)"
    ]
  }
}
